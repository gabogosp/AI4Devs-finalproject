# Copiá este archivo a .env.local (gitignored) y completá los valores.
# NUNCA pongas secretos reales acá: este archivo se commitea.

# --- Dependencias locales (docker-compose) ---
# Puertos de host; cambialos si ya tenés algo escuchando en 5432/6379.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Conexiones de la app (dev local contra docker-compose) ---
DATABASE_URL=postgresql://dsm:dsm@localhost:5432/dsm?schema=public
REDIS_URL=redis://localhost:6379

# --- Proveedores externos (placeholders — completar en .env.local) ---
# MercadoPago (ADR-0006): credenciales de test/prod
MP_ACCESS_TOKEN=replace-me
MP_PUBLIC_KEY=replace-me
MP_WEBHOOK_SECRET=replace-me
# Google Gemini (ADR-0003): embeddings + enriquecimiento
# REQUERIDA EN PRODUCCIÓN: sin ella el arranque falla (D6 de US-005). En local se puede
# dejar vacía/ausente: el runner de enriquecimiento queda `disabled` y el catálogo sigue
# navegable por categoría, pero no se generan embeddings ni descripciones.
GEMINI_API_KEY=replace-me
# Modelos (ADR-0003). La dimensión del de embeddings (768) está fijada en el esquema:
# cambiarlo obliga a re-embeddear todo el catálogo.
GEMINI_ENRICH_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
# Timeouts por llamada, en MILISEGUNDOS.
GEMINI_ENRICH_TIMEOUT_MS=20000
GEMINI_EMBED_TIMEOUT_MS=10000
# Tope de requests por MINUTO del free tier; el limitador del adapter lo respeta.
GEMINI_MAX_RPM=15

# US-005 — runner de enriquecimiento in-process (ADR-0014).
# Kill-switch: en `false` no corre ninguna corrida (el catálogo queda sin enriquecer).
ENRICHMENT_ENABLED=true
# Productos por corrida (máx. 200) y en paralelo dentro de la corrida (máx. 8).
ENRICHMENT_BATCH_SIZE=25
ENRICHMENT_CONCURRENCY=2
# Intentos por producto antes de abandonarlo (AC-4/AC-5).
ENRICHMENT_MAX_ATTEMPTS=5
# Lease del claim en MILISEGUNDOS: una corrida que muere libera la fila al vencer.
ENRICHMENT_LEASE_MS=120000
# Enfriamiento del circuit breaker en MILISEGUNDOS, y fallos consecutivos que lo abren.
ENRICHMENT_COOLDOWN_MS=300000
ENRICHMENT_FAILURE_THRESHOLD=5
# Tope de CARACTERES del texto enriquecido (control de costo y de ruido).
ENRICHMENT_MAX_ENRICHED_CHARS=1200
# Presupuesto por IP de los endpoints admin de enriquecimiento: ventana en MILISEGUNDOS
# y máximo de requests en esa ventana.
ENRICHMENT_RATE_LIMIT_TTL_MS=60000
ENRICHMENT_RATE_LIMIT_MAX=6
# Resend (ADR): email transaccional
RESEND_API_KEY=replace-me
# Cloudflare R2 (imágenes de producto)
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=dsm-product-images

# --- Auth (ADR-0005: JWT propio) ---
JWT_SECRET=replace-me-with-a-long-random-string

# --- Runtime ---
NODE_ENV=development
