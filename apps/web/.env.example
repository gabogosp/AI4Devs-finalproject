# Storefront + panel (Next.js) — variables PÚBLICAS (se inlinean en el build).
# Nunca poner acá secretos server-only: todo lo que lleve NEXT_PUBLIC_ viaja al
# bundle del cliente.

# Base URL de la API del backend (@dsm/api).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Origen público del sitio: canonical, Open Graph y JSON-LD lo usan para
# construir URLs absolutas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del local, formato internacional sin '+' ni separadores (wa.me).
# PLACEHOLDER: el número real es OQ-FE-3, pendiente del cliente.
NEXT_PUBLIC_WHATSAPP_PHONE=5491100000000

# Host del CDN de imágenes permitido en images.remotePatterns.
NEXT_PUBLIC_IMAGE_CDN_HOST=localhost

# --- Superficie de sesión del cliente (US-014, ADR-0013) ---
#
# ⚠ SIN `NEXT_PUBLIC_` A PROPÓSITO: es server-only. El navegador nunca habla con
# el API directamente para auth —lo hace vía el rewrite de /v1/auth/*—, así que
# exponer este origen al bundle sería filtrar topología sin ganar nada.
# En producción es OBLIGATORIA: un rewrite hacia `undefined` devuelve 404 en el
# login, y ese síntoma no dice nada sobre su causa.
API_INTERNAL_ORIGIN=http://localhost:3000
